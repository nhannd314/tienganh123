{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/learning/**",
              "components/navigation/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Lexend))/i]",
        "message": "Font not provided by the design system. Available: Lexend."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|children|icon|key|ref|className|style|children)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: tone, title, children, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:success|warning|danger|info)$/]",
        "message": "<Alert> tone must be one of 'success' | 'warning' | 'danger' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnswerCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|selected|state|disabled|onClick|key|ref|className|style|children)$/]",
        "message": "<AnswerCard> doesn't accept that prop. Declared props: children, selected, state, disabled, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnswerCard'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:correct|wrong)$/]",
        "message": "<AnswerCard> state must be one of 'correct' | 'wrong'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AudioButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|text|lang|disabled|tone|key|ref|className|style|children)$/]",
        "message": "<AudioButton> doesn't accept that prop. Declared props: size, text, lang, disabled, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='AudioButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|lg)$/]",
        "message": "<AudioButton> size must be one of 'sm' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AudioButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|secondary|accent|success|danger)$/]",
        "message": "<AudioButton> tone must be one of 'primary' | 'secondary' | 'accent' | 'success' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|children|inset|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: count, children, inset."
      },
      {
        "selector": "JSXOpeningElement[name.name='Breadcrumbs'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|onNavigate|key|ref|className|style|children)$/]",
        "message": "<Breadcrumbs> doesn't accept that prop. Declared props: items, onNavigate."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|iconLeft|iconRight|fullWidth|disabled|loading|type|onClick|style|key|ref|className|style|children)$/]",
